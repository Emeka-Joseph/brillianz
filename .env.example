# Copy this file to .env and fill in your own values. .env is git-ignored: never commit it.

# Long random string used to sign logins/sessions, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# MySQL / MariaDB (XAMPP defaults: root with an empty password)
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=brillianz_fm

PORT=7000
SELFIE_RETENTION_DAYS=60

# Accounts created on the very first start only. Leave passwords empty to get random ones printed in the console.
ADMIN_EMAIL=admin@brillianzfm.com
ADMIN_PASSWORD=
DEMO_EMPLOYEE_EMAIL=employee@brillianzfm.com
DEMO_EMPLOYEE_PASSWORD=

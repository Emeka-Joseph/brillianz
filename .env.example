# Copy this file to .env and fill in your own values. .env is git-ignored: never commit it.

# Long random string used to sign logins/sessions, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# MySQL / MariaDB
#   XAMPP (local):  DB_USER=root, empty DB_PASSWORD, DB_NAME=brillianz_fm
#   cPanel (live):  the database and user created in cPanel > MySQL Databases, both carry the account prefix,
#                   e.g. DB_USER=cpuser_brillianz, DB_NAME=cpuser_brillianz_fm, DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=brillianz_fm

# Set to 1 on the live site once it is served over https://
SESSION_COOKIE_SECURE=0

PORT=7000
SELFIE_RETENTION_DAYS=60

# Accounts created on the very first start only. Leave passwords empty to get random ones printed in the console.
# On cPanel there is no console to read, so set ADMIN_PASSWORD there.
ADMIN_EMAIL=admin@brillianzfm.com
ADMIN_PASSWORD=
DEMO_EMPLOYEE_EMAIL=employee@brillianzfm.com
DEMO_EMPLOYEE_PASSWORD=
